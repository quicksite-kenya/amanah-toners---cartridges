---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="404 — Page Not Found | Amanah Toners" noindex={true}>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 py-16 text-center">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[
      { name: '404 Page Not Found' }
    ]} />

    <div class="bg-white p-10 sm:p-16 rounded-3xl shadow-2xl border border-slate-200 mt-4">
      <span class="text-[#E4A025] font-black text-6xl sm:text-7xl tracking-widest block mb-4">404</span>
      <h1 class="text-3xl font-black text-[#0B2046] uppercase mb-4">Page Not Found</h1>
      <p class="text-slate-600 mb-8 text-sm font-medium leading-relaxed max-w-md mx-auto">
        The page you requested may have been moved, renamed, or is temporarily unavailable. Explore our verified shop catalog or contact our sales team at KTDA Plaza.
      </p>

      <h2 class="sr-only">Helpful Links</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 text-left">
        <a href="/shop/" class="p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-100 transition-all">
          <p class="font-black text-[#0B2046] text-xs uppercase mb-1">Shop Catalog</p>
          <p class="text-[11px] text-slate-500 font-medium">Browse genuine HP, Canon, Kyocera toners & ink.</p>
        </a>
        <a href="/brands/hp/" class="p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-100 transition-all">
          <p class="font-black text-[#0B2046] text-xs uppercase mb-1">HP Consumables</p>
          <p class="text-[11px] text-slate-500 font-medium">Original LaserJet & JetIntelligence cartridges.</p>
        </a>
        <a href="/contact/" class="p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-100 transition-all">
          <p class="font-black text-[#0B2046] text-xs uppercase mb-1">Contact Office</p>
          <p class="text-[11px] text-slate-500 font-medium">Nairobi KTDA Plaza • Call 0185176133.</p>
        </a>
      </div>

      <a 
        href="/"
        class="inline-flex items-center bg-[#0B2046] hover:bg-[#15346B] text-white font-black py-4 px-8 rounded-xl transition-all uppercase tracking-widest text-xs shadow-xl"
      >
        <svg aria-hidden="true" class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Return to Homepage
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
