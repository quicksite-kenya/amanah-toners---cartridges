---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getProductsByCategorySlug } from '../../lib/db';
import { getImageDimensions } from '../../data/products';

export const prerender = false;

const slug = (Astro.params.slug || '').toLowerCase();

const categoryDetails: Record<string, { category: string; title: string; subtitle: string; narrative: string }> = {
  'toner-cartridges': {
    category: 'Toner Cartridges',
    title: 'Laser Toner Cartridges',
    subtitle: 'Original OEM Toner Cartridges for Enterprise & Office Printers',
    narrative: 'Genuine laser toner cartridges engineered for crisp black text, sharp vector lines, and consistent page yields. Sourced directly from HP, Canon, Kyocera, and Konica Minolta to guarantee optimum printer life and zero smudging.'
  },
  'ink-cartridges': {
    category: 'Ink Cartridges',
    title: 'Original Ink Cartridges & Bottles',
    subtitle: 'Genuine High-Yield Pigment & Dye Inks',
    narrative: 'Authentic high-capacity ink bottles and cartridges delivering rich color saturation, fade resistance, and precision droplet accuracy for Canon PIXMA, HP Smart Tank, and enterprise inkjet printers.'
  },
  'printers': {
    category: 'Printers',
    title: 'Heavy-Duty Office Printers & Copiers',
    subtitle: 'Commercial Workgroup Printers & Multifunction Machines',
    narrative: 'Robust office printing solutions, network laser copiers, and heavy-duty multifunction printers engineered for dependable high-volume document workflows with low per-page operating costs.'
  },
  'printer-accessories': {
    category: 'Printer Accessories',
    title: 'Printer Accessories & Maintenance Kits',
    subtitle: 'Original Manufacturer Maintenance & Imaging Kits',
    narrative: 'Keep your laser printers in peak operating condition with authentic maintenance kits, replacement drums, feed rollers, and fuser components. Reduces downtime and prevents paper misfeeds.'
  }
};

const { category: dbCategory, products } = getProductsByCategorySlug(slug);
const knownDetails = categoryDetails[slug];
const category = dbCategory || knownDetails?.category || '';

if (!category) {
  return new Response('Category not found', { status: 404 });
}

const title = knownDetails?.title || category;
const subtitle = knownDetails?.subtitle || `Genuine ${category} Supplies`;
const narrative = knownDetails?.narrative || `Original certified ${category} for businesses and corporate offices across Kenya.`;
---

<Layout 
  title={`${title} — Amanah Toners & Cartridges`}
  description={`Shop genuine ${title} at Amanah in Nairobi, Kenya. Original manufacturer quality with fast same-day dispatch.`}
>
  <Header slot="header" />

  <!-- Category Hero Banner -->
  <div class="bg-[#0B2046] py-16 text-white relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1.5 bg-[#E4A025]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-[#E4A025] font-black text-xs tracking-[0.3em] uppercase mb-3 inline-block">Category Catalog</span>
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight mb-4">{title}</h1>
        <p class="text-slate-200 text-base font-medium leading-relaxed mb-4">
          {subtitle}
        </p>
        <p class="text-slate-300 text-sm leading-relaxed max-w-2xl">
          {narrative}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[
      { name: 'Categories' },
      { name: category }
    ]} />

    <!-- Action Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
      <div>
        <h2 class="text-xl font-black text-[#0B2046] uppercase">In-Stock {category}</h2>
        <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">
          Showing {products.length} verified products
        </p>
      </div>
      <div>
        <a 
          href="/shop/" 
          class="inline-flex items-center text-xs font-black uppercase tracking-wider text-[#0B2046] hover:text-[#E4A025] transition-colors"
        >
          <span>View All Categories</span>
          <svg aria-hidden="true" class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {products.map((product, idx) => {
        const dims = getImageDimensions(product.imageUrl);
        return (
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col border border-slate-100 group transition-all hover:-translate-y-2 duration-300">
            <div class="aspect-square bg-slate-50 relative overflow-hidden flex items-center justify-center p-6">
              <img
                src={product.imageUrl}
                alt={product.model}
                width={dims.width}
                height={dims.height}
                loading={idx >= 4 ? 'lazy' : 'eager'}
                decoding="async"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4">
                <span class="bg-[#0B2046] text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest shadow-md">
                  {product.brand}
                </span>
              </div>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center space-x-2 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                <span>{product.brand}</span>
                <span aria-hidden="true">·</span>
                <span class="text-emerald-600 font-black">In Stock</span>
              </div>
              <a href={`/products/${product.slug}/`}>
                <h3 class="text-base font-black text-[#0B2046] mb-1 uppercase hover:text-[#E4A025] transition-colors leading-snug">
                  {product.model}
                </h3>
              </a>
              {product.partNumber && (
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">
                  Part: {product.partNumber}
                </p>
              )}
              <p class="text-xs text-slate-500 mb-6 flex-1 line-clamp-2 font-medium leading-relaxed">{product.description}</p>
              
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100 gap-2">
                <a 
                  href={`/products/${product.slug}/`} 
                  class="bg-slate-100 hover:bg-slate-200 text-[#0B2046] text-xs font-black px-3 py-2.5 rounded-xl transition-all text-center uppercase tracking-wider flex-1"
                >
                  Details
                </a>
                <button
                  type="button"
                  aria-label={`Add ${product.model} to inquiry list`}
                  class="category-add-btn bg-[#0B2046] hover:bg-[#15346B] text-white text-xs font-black px-4 py-2.5 rounded-xl transition-all shadow-md active:scale-95 uppercase tracking-wider flex items-center justify-center space-x-1 flex-1 cursor-pointer"
                  data-product={JSON.stringify(product)}
                >
                  <span class="btn-label">Inquire</span>
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Category Advice Card -->
    <div class="mt-16 bg-[#0B2046] rounded-3xl p-8 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
      <div class="relative z-10">
        <span class="text-[#E4A025] font-black text-xs uppercase tracking-widest block mb-1">Corporate Inquiries & Bulk Supply</span>
        <h3 class="text-2xl font-black uppercase mb-2">Need a custom quote for {title}?</h3>
        <p class="text-slate-300 text-xs font-medium max-w-xl">
          We provide formal proforma invoices, scheduled monthly refills, and direct office delivery across Nairobi and upcountry.
        </p>
      </div>
      <div class="relative z-10 flex flex-col sm:flex-row gap-3 shrink-0">
        <a 
          href={`https://wa.me/254185176133?text=${encodeURIComponent(`Hello Amanah Toners, I need a quotation for ${title}.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#E4A025] hover:bg-yellow-500 text-[#0B2046] font-black px-6 py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all shadow-xl flex items-center justify-center space-x-2"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  document.querySelectorAll('.category-add-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const productData = JSON.parse(btn.getAttribute('data-product') || '{}');
        if (!productData || !productData.id) return;
        const existingCart = JSON.parse(localStorage.getItem('amanah_cart') || '[]');
        const index = existingCart.findIndex((item: { id?: string }) => item.id === productData.id);
        if (index > -1) {
          existingCart[index].quantity += 1;
        } else {
          existingCart.push({ ...productData, quantity: 1 });
        }
        localStorage.setItem('amanah_cart', JSON.stringify(existingCart));
        window.dispatchEvent(new Event('cartUpdated'));

        const labelEl = btn.querySelector('.btn-label');
        if (labelEl) labelEl.textContent = 'Added!';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          if (labelEl) labelEl.textContent = 'Inquire';
          btn.classList.remove('bg-emerald-600');
        }, 1500);
      } catch (e) {
        console.error(e);
      }
    });
  });
</script>
