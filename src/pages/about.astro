---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout 
  title="About Us — Amanah Toners & Cartridges Nairobi" 
  description="Learn about Amanah Toners & Cartridges, Kenya's premier supplier of original printing consumables headquartered at KTDA Plaza, Nairobi."
>
  <Header slot="header" />

  <!-- Hero Banner -->
  <div class="bg-[#0B2046] py-16 text-white relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1.5 bg-[#E4A025]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="text-[#E4A025] font-black text-xs tracking-[0.3em] uppercase mb-3 inline-block">Our Heritage & Mission</span>
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight mb-4">About Amanah</h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm uppercase tracking-widest font-bold">
        Trust Every Print — Kenya's premier distributor of 100% authentic toner cartridges and printer consumables.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[
      { name: 'About Us' }
    ]} />

    <!-- Main Profile Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
      <div class="lg:col-span-7 space-y-6">
        <span class="text-[#E4A025] font-black text-xs tracking-[0.3em] uppercase block">Serving Kenyan Commerce</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#0B2046] uppercase leading-tight">
          Empowering Offices With <span class="text-[#E4A025]">Genuine Printing</span>
        </h2>
        <div class="space-y-4 text-slate-600 font-medium text-base leading-relaxed">
          <p>
            Amanah Toners & Cartridges was established with a singular, uncompromising purpose: to protect businesses from counterfeit, low-yield printer consumables that cause print defects, fuser damage, and costly office downtime.
          </p>
          <p>
            Operating from our headquarters at <strong class="text-[#0B2046]">KTDA Plaza, Nairobi</strong>, we have earned the trust of over 2,000 corporate organizations, educational institutions, government agencies, and commercial printing centers across Kenya.
          </p>
          <p>
            Our distribution network exclusively deals in 100% genuine OEM toner cartridges, original ink refill bottles, workgroup laser copiers, and maintenance kits from the world's most trusted brands: <strong class="text-[#0B2046]">HP, Canon, Kyocera, and Konica Minolta</strong>.
          </p>
        </div>

        <div class="pt-4 grid grid-cols-3 gap-6 border-t border-slate-200">
          <div>
            <p class="text-3xl font-black text-[#0B2046]">10,000+</p>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-1">Cartridges Delivered</p>
          </div>
          <div>
            <p class="text-3xl font-black text-[#E4A025]">100%</p>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-1">Genuine Certified</p>
          </div>
          <div>
            <p class="text-3xl font-black text-[#0B2046]">2,000+</p>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-1">Enterprise Clients</p>
          </div>
        </div>
      </div>

      <!-- Core Values Card -->
      <div class="lg:col-span-5 bg-[#0B2046] text-white p-8 sm:p-10 rounded-3xl shadow-2xl relative border-t-4 border-[#E4A025]">
        <h3 class="text-2xl font-black uppercase mb-6 text-[#E4A025]">Our Core Principles</h3>
        <ul class="space-y-6">
          <li class="flex items-start space-x-4">
            <div class="bg-[#E4A025] p-2.5 rounded-xl text-[#0B2046] shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <h4 class="font-black uppercase text-sm mb-1 text-white">Zero Counterfeits</h4>
              <p class="text-xs text-slate-300 leading-relaxed font-medium">Every carton features factory hologram seals and verified serial numbers. We never stock remanufactured knockoffs.</p>
            </div>
          </li>

          <li class="flex items-start space-x-4">
            <div class="bg-white/10 p-2.5 rounded-xl text-[#E4A025] shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h4 class="font-black uppercase text-sm mb-1 text-white">Same-Day Rapid Dispatch</h4>
              <p class="text-xs text-slate-300 leading-relaxed font-medium">Fast delivery across Nairobi CBD, Upper Hill, Westlands, and Industrial Area, plus reliable upcountry parcel dispatch.</p>
            </div>
          </li>

          <li class="flex items-start space-x-4">
            <div class="bg-white/10 p-2.5 rounded-xl text-[#E4A025] shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
            <div>
              <h4 class="font-black uppercase text-sm mb-1 text-white">Direct Technical Support</h4>
              <p class="text-xs text-slate-300 leading-relaxed font-medium">Our product experts assist you in identifying exact cartridge part codes and compatible printer models.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Corporate Headquarters & CTA Strip -->
    <div class="bg-slate-50 border border-slate-200/80 rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <span class="text-[#E4A025] font-black text-xs uppercase tracking-widest block mb-1">Corporate Office & Counter Pickup</span>
        <h3 class="text-2xl font-black text-[#0B2046] uppercase mb-2">Visit Amanah at KTDA Plaza</h3>
        <p class="text-slate-600 text-sm font-medium max-w-xl">
          Located centrally in Nairobi CBD, our offices and warehouse are open Monday to Saturday for walk-in consultations, counter pickups, and wholesale supply requests.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 shrink-0">
        <a 
          href="/shop/" 
          class="bg-[#0B2046] hover:bg-[#15346B] text-white font-black py-4 px-8 rounded-xl uppercase tracking-widest text-xs shadow-xl transition-all text-center"
        >
          View Shop Catalog
        </a>
        <a 
          href="/contact/" 
          class="bg-[#E4A025] hover:bg-yellow-500 text-[#0B2046] font-black py-4 px-8 rounded-xl uppercase tracking-widest text-xs shadow-xl transition-all text-center"
        >
          Contact Our Team
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
