---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout 
  title="Contact Us — Parem Toners Nairobi" 
  description="Contact Parem Toners at Latema Road, 00400. Call or WhatsApp 0722 694443 (+254 722 694443) or email info@paremagencies.co.ke for inquiries and quotes."
>
  <Header slot="header" />

  <!-- Hero Banner -->
  <div class="bg-[#0B2046] py-16 text-white relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1.5 bg-[#00CCFF]"></div>
    <div class="absolute -top-24 right-0 w-96 h-96 bg-[#00CCFF]/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="text-[#00CCFF] font-black text-xs tracking-[0.3em] uppercase mb-3 inline-block">Direct Inquiries & Support</span>
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight mb-4">Contact Parem Toners</h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm uppercase tracking-widest font-bold">
        We are ready to assist with your printer consumable requirements, bulk quotes, and rapid office delivery.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[
      { name: 'Contact Us' }
    ]} />

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Phone Card -->
      <div class="bg-white p-8 rounded-3xl shadow-xl border border-[#BAE6FD] flex flex-col items-center text-center">
        <div class="w-14 h-14 bg-[#00CCFF] rounded-2xl flex items-center justify-center text-[#0B2046] mb-6 shadow-md">
          <svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <h2 class="text-base font-black text-[#0B2046] uppercase mb-2">Telephone & Email</h2>
        <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Direct Voice & Email Desk</p>
        <a href="tel:+254722694443" class="text-xl font-black text-[#0B2046] hover:text-[#007BA7] transition-colors">0722 694443</a>
        <a href="tel:+254722694443" class="text-xs font-bold text-slate-600 hover:text-[#007BA7] transition-colors mt-1">+254 722 694443</a>
        <a href="mailto:info@paremagencies.co.ke" class="text-xs font-black text-[#007BA7] hover:underline transition-colors mt-3 break-all">info@paremagencies.co.ke</a>
      </div>

      <!-- Location Card -->
      <div class="bg-white p-8 rounded-3xl shadow-xl border border-[#BAE6FD] flex flex-col items-center text-center">
        <div class="w-14 h-14 bg-[#0B2046] rounded-2xl flex items-center justify-center text-[#00CCFF] mb-6 shadow-md border border-[#00CCFF]/30">
          <svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h2 class="text-base font-black text-[#0B2046] uppercase mb-2">Office & Counter Pickup</h2>
        <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-3">Nairobi Central Business District</p>
        <p class="text-base font-black text-[#0B2046]">Latema Road, 00400</p>
        <a href="https://paremagencies.co.ke" target="_blank" rel="noopener noreferrer" class="text-xs font-black text-[#007BA7] hover:underline mt-3">paremagencies.co.ke</a>
      </div>

      <!-- WhatsApp Card -->
      <div class="bg-white p-8 rounded-3xl shadow-xl border border-[#BAE6FD] flex flex-col items-center text-center">
        <div class="w-14 h-14 bg-emerald-600 rounded-2xl flex items-center justify-center text-white mb-6 shadow-md">
          <svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </div>
        <h2 class="text-base font-black text-[#0B2046] uppercase mb-2">WhatsApp Channel</h2>
        <p class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-4">Fast Chat & Quote Dispatch</p>
        <a 
          href="https://wa.me/254722694443" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-black px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md"
        >
          Chat +254 722 694443
        </a>
      </div>
    </div>

    <!-- Contact Form & Hours Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Interactive Form -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-[#BAE6FD]">
        <div id="contact-form-container">
          <span class="text-[#007BA7] font-black text-xs tracking-[0.3em] uppercase block mb-1">Direct Inquiry</span>
          <h2 class="text-2xl font-black text-[#0B2046] uppercase mb-6">Send Us a Message</h2>

          <form id="contact-message-form" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-name" class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Your Full Name *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  required 
                  class="w-full bg-[#F0FBFF] border border-[#BAE6FD] rounded-xl py-3 px-4 focus:ring-2 focus:ring-[#00CCFF] outline-none font-bold text-sm text-[#0B2046]"
                  placeholder="e.g. David Mwangi"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Phone / WhatsApp *</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  required 
                  class="w-full bg-[#F0FBFF] border border-[#BAE6FD] rounded-xl py-3 px-4 focus:ring-2 focus:ring-[#00CCFF] outline-none font-bold text-sm text-[#0B2046]"
                  placeholder="e.g. 0712345678"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contact-org" class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Company / Organization (Optional)</label>
                <input 
                  type="text" 
                  id="contact-org" 
                  class="w-full bg-[#F0FBFF] border border-[#BAE6FD] rounded-xl py-3 px-4 focus:ring-2 focus:ring-[#00CCFF] outline-none font-bold text-sm text-[#0B2046]"
                  placeholder="e.g. Acme Enterprises Ltd"
                />
              </div>
              <div>
                <label for="contact-subject" class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Inquiry Type</label>
                <select 
                  id="contact-subject"
                  class="w-full bg-[#F0FBFF] border border-[#BAE6FD] rounded-xl py-3 px-4 focus:ring-2 focus:ring-[#00CCFF] outline-none font-bold text-sm text-[#0B2046]"
                >
                  <option value="Toner Price Quotation">Toner Price Quotation</option>
                  <option value="Bulk Corporate Refill Supply">Bulk Corporate Refill Supply</option>
                  <option value="Model Compatibility Verification">Model Compatibility Verification</option>
                  <option value="Printer Purchase Inquiry">Printer Purchase Inquiry</option>
                  <option value="General Question">General Question</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-msg" class="block text-xs font-black text-slate-700 uppercase tracking-wider mb-2">Toner Models or Message Details *</label>
              <textarea 
                rows="4" 
                id="contact-msg" 
                required
                class="w-full bg-[#F0FBFF] border border-[#BAE6FD] rounded-xl py-3 px-4 focus:ring-2 focus:ring-[#00CCFF] outline-none font-bold text-sm text-[#0B2046]"
                placeholder="Mention cartridge codes (e.g. HP 212A, Canon 071, Kyocera TK-1170) or printer model numbers and quantity required..."
              ></textarea>
            </div>

            <p id="contact-form-error" role="alert" class="hidden text-red-600 text-xs font-bold"></p>

            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full bg-[#0B2046] hover:bg-[#15346B] text-white font-black py-4 rounded-xl uppercase tracking-[0.2em] text-xs shadow-xl transition-all cursor-pointer border border-[#00CCFF]/30"
            >
              Submit Inquiry Request
            </button>
          </form>
        </div>
      </div>

      <!-- Business Hours & Directions -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-[#0B2046] text-white p-8 rounded-3xl shadow-xl relative border-t-4 border-[#00CCFF]">
          <h2 class="text-xl font-black uppercase mb-6 text-[#00CCFF]">Business Operating Hours</h2>
          <ul class="space-y-4 text-xs font-bold uppercase tracking-wider divide-y divide-[#00CCFF]/20">
            <li class="flex justify-between items-center pt-3 first:pt-0">
              <span class="text-slate-300">Monday — Friday</span>
              <span class="text-white font-black">8:00 AM – 6:00 PM</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-300">Saturday</span>
              <span class="text-white font-black">9:00 AM – 4:00 PM</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-300">Sunday & Public Holidays</span>
              <span class="text-[#00CCFF] font-black">Closed (WhatsApp Standby)</span>
            </li>
          </ul>
        </div>

        <div class="bg-[#E6F9FF] border border-[#BAE6FD] p-8 rounded-3xl">
          <h2 class="text-base font-black text-[#0B2046] uppercase mb-3">Headquarters Location</h2>
          <p class="text-xs text-slate-700 font-medium leading-relaxed mb-4">
            Parem Toners is situated at <strong class="text-[#0B2046]">Latema Road, 00400</strong>, within Nairobi Central Business District. Easy access for counter collection or courier dispatch.
          </p>
          <div class="p-4 bg-white rounded-xl border border-[#BAE6FD] text-xs font-bold text-slate-700 space-y-1">
            <p class="text-[10px] text-[#007BA7] uppercase tracking-widest mb-1">Direct Address &amp; Channels</p>
            <p class="font-black text-[#0B2046]">Latema Road, 00400</p>
            <p class="text-slate-600">Tel: 0722 694443 / +254 722 694443</p>
            <p class="text-slate-600">Email: <a href="mailto:info@paremagencies.co.ke" class="text-[#007BA7] hover:underline">info@paremagencies.co.ke</a></p>
            <p class="text-slate-600">Web: <a href="https://paremagencies.co.ke" target="_blank" rel="noopener noreferrer" class="text-[#007BA7] hover:underline">paremagencies.co.ke</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  const form = document.getElementById('contact-message-form');
  const container = document.getElementById('contact-form-container');
  const errorEl = document.getElementById('contact-form-error');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

  function createSvg(pathDefs: string[], className: string): SVGSVGElement {
    const ns = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('class', className);
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('aria-hidden', 'true');
    for (const d of pathDefs) {
      const p = document.createElementNS(ns, 'path');
      p.setAttribute('stroke-linecap', 'round');
      p.setAttribute('stroke-linejoin', 'round');
      p.setAttribute('stroke-width', '2');
      p.setAttribute('d', d);
      svg.appendChild(p);
    }
    return svg;
  }

  function showContactSuccess(target: HTMLElement, name: string, phone: string, waLink: string) {
    const wrap = document.createElement('div');
    wrap.className = 'py-8 text-center';

    const iconCircle = document.createElement('div');
    iconCircle.className = 'w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4';
    iconCircle.appendChild(createSvg(['M5 13l4 4L19 7'], 'w-8 h-8'));

    const heading = document.createElement('h2');
    heading.className = 'text-2xl font-black text-[#0B2046] uppercase mb-2';
    heading.textContent = 'Message Sent Successfully!';

    const msgP = document.createElement('p');
    msgP.className = 'text-slate-600 text-sm font-medium mb-6 leading-relaxed max-w-md mx-auto';
    msgP.append('Thank you, ');
    const nameStrong = document.createElement('strong');
    nameStrong.className = 'text-[#0B2046]';
    nameStrong.textContent = name;
    msgP.appendChild(nameStrong);
    msgP.append('. Your inquiry has been sent to our sales desk. We will reach out to ');
    const phoneStrong = document.createElement('strong');
    phoneStrong.className = 'text-[#0B2046]';
    phoneStrong.textContent = phone;
    msgP.appendChild(phoneStrong);
    msgP.append(' shortly.');

    const actions = document.createElement('div');
    actions.className = 'flex flex-col sm:flex-row items-center justify-center gap-4';

    const waBtn = document.createElement('a');
    waBtn.href = waLink;
    waBtn.target = '_blank';
    waBtn.rel = 'noopener noreferrer';
    waBtn.className = 'w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-black py-3.5 px-6 rounded-xl text-xs uppercase tracking-wider shadow-lg flex items-center justify-center space-x-2';
    waBtn.appendChild(
      createSvg(
        ['M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'],
        'w-4 h-4'
      )
    );
    const waLabel = document.createElement('span');
    waLabel.textContent = 'Continue on WhatsApp';
    waBtn.appendChild(waLabel);

    const shopBtn = document.createElement('a');
    shopBtn.href = '/shop/';
    shopBtn.className = 'w-full sm:w-auto bg-[#0B2046] hover:bg-[#15346B] text-white font-black py-3.5 px-6 rounded-xl text-xs uppercase tracking-wider shadow-lg text-center';
    shopBtn.textContent = 'Browse Catalog';

    actions.append(waBtn, shopBtn);
    wrap.append(iconCircle, heading, msgP, actions);
    target.replaceChildren(wrap);
  }

  if (form && container) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
      const org = (document.getElementById('contact-org') as HTMLInputElement).value.trim();
      const subject = (document.getElementById('contact-subject') as HTMLSelectElement).value;
      const message = (document.getElementById('contact-msg') as HTMLTextAreaElement).value.trim();

      if (name.length < 2 || phone.length < 6) {
        if (errorEl) {
          errorEl.textContent = 'Please provide a valid full name and phone number.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      if (errorEl) errorEl.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
      }

      try {
        await fetch('/api/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'contact',
            name,
            phone,
            organization: org,
            subject,
            message,
          }),
        });
      } catch {
        // Proceed cleanly to WhatsApp fallback if offline
      }

      const waText = `Hello Parem Toners, my name is ${name} (Phone: ${phone}${org ? ', ' + org : ''}).\nInquiry: ${subject}\nMessage: ${message}`;
      const waLink = `https://wa.me/254722694443?text=${encodeURIComponent(waText)}`;
      showContactSuccess(container, name, phone, waLink);
    });
  }
</script>
