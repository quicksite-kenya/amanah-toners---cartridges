---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAllProducts, getProductBySlug } from '../../lib/db';
import { getImageDimensions } from '../../data/products';

export const prerender = false;

const slug = Astro.params.slug || '';
const product = await getProductBySlug(slug);

if (!product) {
  return new Response('Product not found', { status: 404 });
}

const allProducts = await getAllProducts();
const relatedProducts = allProducts
  .filter((p) => p.brand === product.brand && p.id !== product.id)
  .slice(0, 4);

const mainDims = getImageDimensions(product.imageUrl);
const waOrderUrl = `https://wa.me/254185176133?text=${encodeURIComponent(`Hello Amanah Toners, I would like to inquire about ${product.brand} ${product.model} (Part: ${product.partNumber || 'N/A'}). Please provide a price quotation and delivery options for Nairobi.`)}`;
---

<Layout 
  title={`${product.model} (${product.brand}) â€” Amanah Toners Kenya`} 
  description={product.description}
>
  <Header slot="header" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <Breadcrumb items={[
      { name: 'Shop', href: '/shop/' },
      { name: product.brand, href: `/brands/${product.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/` },
      { name: product.model }
    ]} />

    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 p-6 sm:p-10 lg:p-12 mb-16">
      <!-- Image Gallery Column -->
      <div class="lg:col-span-6 flex flex-col items-center justify-center bg-slate-50 rounded-2xl p-8 border border-slate-100 relative">
        <div class="absolute top-6 left-6">
          <span class="bg-[#0B2046] text-white text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-md">
            {product.brand}
          </span>
        </div>
        <img 
          src={product.imageUrl} 
          alt={product.model} 
          width={mainDims.width}
          height={mainDims.height}
          decoding="async"
          class="max-h-[420px] w-full object-contain my-auto" 
        />
        <div class="mt-4 pt-4 border-t border-slate-200/60 w-full flex items-center justify-between text-[11px] font-bold text-slate-500 uppercase tracking-wider">
          <span>Official Packaging</span>
          <span class="text-[#0B2046] font-black">100% Genuine Certified</span>
        </div>
      </div>

      <!-- Product Details Column -->
      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <!-- Unboxed metadata line -->
          <div class="flex items-center space-x-2 text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">
            <span class="text-[#0B2046] font-black">{product.category}</span>
            <span aria-hidden="true">Â·</span>
            <span class="text-emerald-600 font-black">In Stock ({product.stock} units)</span>
            <span aria-hidden="true">Â·</span>
            <span>OEM Original</span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#0B2046] uppercase tracking-tight mb-4 leading-tight">
            {product.model}
          </h1>
          
          {product.partNumber && (
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4">
              OEM Part Code: <span class="text-[#0B2046] font-black">{product.partNumber}</span>
            </p>
          )}

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 font-medium">
            {product.description}
          </p>

          <!-- Compatible Printers structured box -->
          {product.compatiblePrinters && (
            <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200/80 mb-6">
              <div class="flex items-center space-x-2 text-[#0B2046] font-black text-xs uppercase tracking-wider mb-2">
                <svg aria-hidden="true" class="w-4 h-4 text-[#E4A025]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                <span>Compatible Printer Models</span>
              </div>
              <p class="text-xs sm:text-sm font-bold text-slate-700 leading-relaxed">
                {product.compatiblePrinters}
              </p>
            </div>
          )}

          <!-- Guarantee Strip -->
          <div class="grid grid-cols-2 gap-3 mb-8">
            <div class="p-3.5 rounded-xl border border-slate-100 bg-slate-50 flex items-center space-x-3">
              <svg aria-hidden="true" class="w-5 h-5 text-[#E4A025] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <div>
                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Quality</p>
                <p class="text-xs font-black text-[#0B2046] uppercase">100% Genuine</p>
              </div>
            </div>
            <div class="p-3.5 rounded-xl border border-slate-100 bg-slate-50 flex items-center space-x-3">
              <svg aria-hidden="true" class="w-5 h-5 text-[#0B2046] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <div>
                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Dispatch</p>
                <p class="text-xs font-black text-[#0B2046] uppercase">Nairobi Same-Day</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Purchase & Inquiry Actions -->
        <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            id="add-to-inquiry-btn"
            data-product={JSON.stringify(product)}
            class="flex-1 bg-[#0B2046] hover:bg-[#15346B] text-white font-black py-4 px-6 rounded-xl uppercase tracking-[0.2em] text-xs shadow-xl transition-all text-center flex items-center justify-center space-x-2 active:scale-95 cursor-pointer"
          >
            <svg aria-hidden="true" class="w-4 h-4 text-[#E4A025]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span id="btn-text">Add to Inquiry List</span>
          </button>
          
          <a
            href={waOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-black py-4 px-6 rounded-xl uppercase tracking-[0.2em] text-xs shadow-xl transition-all text-center flex items-center justify-center space-x-2"
          >
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <span>WhatsApp Order</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div>
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-2xl font-black text-[#0B2046] uppercase">Related {product.brand} Products</h2>
            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">
              Complementary toners and consumables
            </p>
          </div>
          <a href={`/brands/${product.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="text-xs font-black uppercase tracking-wider text-[#0B2046] hover:text-[#E4A025] transition-colors">
            All {product.brand} &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {relatedProducts.map((rel) => {
            const relDims = getImageDimensions(rel.imageUrl);
            return (
              <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col border border-slate-100 group transition-all hover:-translate-y-1">
                <div class="aspect-square bg-slate-50 relative overflow-hidden flex items-center justify-center p-4">
                  <img
                    src={rel.imageUrl}
                    alt={rel.model}
                    width={relDims.width}
                    height={relDims.height}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform"
                  />
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <a href={`/products/${rel.slug}/`}>
                    <h3 class="text-sm font-black text-[#0B2046] uppercase hover:text-[#E4A025] transition-colors leading-snug mb-1">
                      {rel.model}
                    </h3>
                  </a>
                  <p class="text-xs text-slate-500 line-clamp-2 mb-4 font-medium">{rel.description}</p>
                  <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-[10px] font-black text-emerald-600 uppercase">In Stock</span>
                    <a href={`/products/${rel.slug}/`} class="text-xs font-black text-[#0B2046] hover:text-[#E4A025] uppercase tracking-wider">
                      View &rarr;
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  const btn = document.getElementById('add-to-inquiry-btn');
  const btnText = document.getElementById('btn-text');

  if (btn) {
    btn.addEventListener('click', () => {
      try {
        const productData = JSON.parse(btn.getAttribute('data-product') || '{}');
        if (!productData || !productData.id) return;
        const existingCart = JSON.parse(localStorage.getItem('amanah_cart') || '[]');
        const index = existingCart.findIndex((item: { id?: string }) => item.id === productData.id);
        if (index > -1) {
          existingCart[index].quantity += 1;
        } else {
          existingCart.push({ ...productData, quantity: 1 });
        }
        localStorage.setItem('amanah_cart', JSON.stringify(existingCart));
        window.dispatchEvent(new Event('cartUpdated'));

        if (btnText) btnText.textContent = 'Added to Inquiry List!';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          if (btnText) btnText.textContent = 'Add to Inquiry List';
          btn.classList.remove('bg-emerald-600');
        }, 1800);
      } catch (e) {
        console.error(e);
      }
    });
  }
</script>
