---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Shop', href: '/shop/' },
  { name: 'About', href: '/about/' },
  { name: 'Delivery', href: '/delivery/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Contact', href: '/contact/' },
];

const brandLinks = [
  { name: 'HP', href: '/brands/hp/' },
  { name: 'Canon', href: '/brands/canon/' },
  { name: 'Kyocera', href: '/brands/kyocera/' },
  { name: 'Konica Minolta', href: '/brands/konica-minolta/' },
];

const categoryLinks = [
  { name: 'Toner Cartridges', href: '/categories/toner-cartridges/' },
  { name: 'Ink Cartridges', href: '/categories/ink-cartridges/' },
  { name: 'Printers', href: '/categories/printers/' },
  { name: 'Accessories', href: '/categories/printer-accessories/' },
];
---

<header class="bg-[#0B2046] shadow-2xl sticky top-1.5 z-50 border-b border-[#00CCFF]/25">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      {/* Brand Zone */}
      <a href="/" class="flex items-center cursor-pointer group shrink-0">
        <div class="bg-white p-1.5 rounded-2xl shadow-xl group-hover:scale-105 transition-all duration-300 border-2 border-[#00CCFF]/50 group-hover:border-[#00CCFF]">
          <img
            src="/assets/aistudio/parem3_8db6bee6.jpg"
            alt="Parem Toners"
            width="196"
            height="200"
            decoding="async"
            class="h-11 w-11 object-contain rounded-xl"
          />
        </div>
        <div class="ml-4 hidden sm:block">
          <p class="text-white font-black text-sm tracking-[0.22em] uppercase leading-none mb-1">Parem Toners</p>
          <p class="text-[#00CCFF] font-black text-[9px] uppercase tracking-[0.2em] leading-none opacity-95 italic">Trust Every Print</p>
        </div>
      </a>

      {/* Primary Desktop Navigation Links */}
      <nav aria-label="Main Navigation" class="hidden lg:flex items-center space-x-8">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="text-[11px] font-black uppercase tracking-[0.25em] text-white/85 hover:text-[#00CCFF] transition-all relative group py-2"
          >
            {item.name}
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#00CCFF] transition-all group-hover:w-full"></span>
          </a>
        ))}
      </nav>

      {/* Action Zone: Phone, Cart, Mobile Toggle */}
      <div class="flex items-center space-x-4">
        <a 
          href="tel:+254722694443" 
          class="hidden md:flex items-center space-x-2 bg-[#00CCFF]/10 hover:bg-[#00CCFF]/20 px-4 py-2.5 rounded-xl border border-[#00CCFF]/30 text-white transition-all"
        >
          <svg aria-hidden="true" class="w-4 h-4 text-[#00CCFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span class="text-xs font-black tracking-wider">0722 694443</span>
        </a>

        <a
          href="/inquiry/"
          aria-label="Inquiry Cart"
          class="relative flex items-center p-3 bg-[#00CCFF]/10 hover:bg-[#00CCFF]/20 rounded-2xl text-white transition-all group border border-[#00CCFF]/25"
        >
          <svg aria-hidden="true" class="w-5 h-5 group-hover:text-[#00CCFF] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span id="cart-badge" class="absolute -top-1.5 -right-1.5 flex h-6 w-6 items-center justify-center rounded-full bg-[#00CCFF] text-[11px] font-black text-[#0B2046] shadow-xl leading-none">
            0
          </span>
        </a>

        {/* Mobile Menu Button */}
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          class="lg:hidden p-3 rounded-2xl bg-[#00CCFF]/10 hover:bg-[#00CCFF]/20 text-white border border-[#00CCFF]/25 focus:outline-none cursor-pointer"
        >
          <svg id="menu-icon-open" aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="menu-icon-close" aria-hidden="true" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div id="mobile-menu-drawer" class="lg:hidden hidden bg-[#0B2046] border-t border-[#00CCFF]/20 px-4 pt-4 pb-8 shadow-2xl">
    <div class="flex flex-col space-y-4">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-xs font-black uppercase tracking-[0.25em] text-white/90 hover:text-[#00CCFF] py-2 border-b border-white/10"
        >
          {item.name}
        </a>
      ))}

      <div class="pt-2">
        <p class="text-[10px] font-black uppercase tracking-widest text-[#00CCFF] mb-2">Shop by Brand</p>
        <div class="grid grid-cols-2 gap-2">
          {brandLinks.map((brand) => (
            <a href={brand.href} class="text-xs font-bold text-slate-200 hover:text-[#00CCFF] py-1">
              {brand.name}
            </a>
          ))}
        </div>
      </div>

      <div class="pt-2">
        <p class="text-[10px] font-black uppercase tracking-widest text-[#00CCFF] mb-2">Shop by Category</p>
        <div class="grid grid-cols-2 gap-2">
          {categoryLinks.map((cat) => (
            <a href={cat.href} class="text-xs font-bold text-slate-200 hover:text-[#00CCFF] py-1">
              {cat.name}
            </a>
          ))}
        </div>
      </div>

      <div class="pt-4 border-t border-[#00CCFF]/20 flex flex-col space-y-3">
        <a href="tel:+254722694443" class="text-xs font-black text-[#00CCFF] flex items-center space-x-2">
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>Call: 0722 694443 / +254 722 694443</span>
        </a>
        <a href="mailto:info@paremagencies.co.ke" class="text-xs font-bold text-slate-200 hover:text-[#00CCFF]">
          info@paremagencies.co.ke
        </a>
        <p class="text-[11px] font-bold text-slate-300">Location: Latema Road, 00400</p>
      </div>
    </div>
  </div>
</header>

<script>
  function updateCartBadge() {
    try {
      const stored = localStorage.getItem('amanah_cart');
      const cart = stored ? JSON.parse(stored) : [];
      const total = Array.isArray(cart)
        ? cart.reduce((acc: number, item: any) => acc + (Number(item.quantity) || 0), 0)
        : 0;
      const badge = document.getElementById('cart-badge');
      if (badge) {
        badge.textContent = total.toString();
      }
    } catch (e) {
      console.error(e);
    }
  }

  updateCartBadge();
  window.addEventListener('cartUpdated', updateCartBadge);

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isClosed = drawer.classList.contains('hidden');
      if (isClosed) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
